config_version=5

[application]
config/name="Doodle Rally — Cat Racers"
config/version="1.4.0"
config/description="Small cats. Big adventures. A standalone 3D kart racer."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://assets/icon.svg"
config/use_custom_user_dir=true
config/custom_user_dir_name="Doodle Rally Cat Racers"

[display]
window/size/viewport_width=1440
window/size/viewport_height=900
window/size/window_width_override=1280
window/size/window_height_override=800
window/size/min_width=960
window/size/min_height=600
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[rendering]
renderer/rendering_method="forward_plus"
renderer/rendering_method.mobile="mobile"
rendering_device/driver="metal"
textures/default_filters/use_nearest_mipmap_filter=false
textures/vram_compression/import_etc2_astc=true
textures/vram_compression/import_s3tc_bptc=true
anti_aliasing/quality/msaa_3d=1
lights_and_shadows/directional_shadow/size=2048
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=2
environment/ssao/quality=1
environment/ssao/half_size=true
environment/ssil/quality=1
environment/ssil/half_size=true
environment/volumetric_fog/volume_size=32
environment/volumetric_fog/volume_depth=48
environment/defaults/default_clear_color=Color(0.32, 0.63, 0.83, 1)

[physics]
common/physics_ticks_per_second=60
